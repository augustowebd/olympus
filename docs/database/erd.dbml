Project olympus {
  database_type: 'PostgreSQL'
  note: 'MER do Hidra — fonte de dados do ecossistema Olympus'
}

TableGroup pessoas {
  users
  colaboradores
  fornecedores
  clientes
  pessoas.paises
  pessoas.ufs
  pessoas.cidades
  pessoas.enderecos
  pessoas.colaboradores_enderecos
  pessoas.fornecedores_enderecos
  pessoas.clientes_enderecos
}

Table users {
  id integer [pk, increment]
  name varchar
  email varchar [unique, not null]
  email_verified_at timestamp [null]
  password varchar
  remember_token varchar [null]
  created_at timestamp
  updated_at timestamp

  note: '''
    Centro de verdade de identidade do ecossistema.
    Toda pessoa (colaborador, fornecedor, cliente) tem exatamente um registro aqui.
    Tabela padrão do Laravel — chave bigint autoincrement, não UUID.
  '''
}

Table colaboradores {
  id uuid [pk]
  user_id integer [not null, unique, ref: > users.id]
  created_at timestamp
  updated_at timestamp

  note: 'Usuário que é colaborador (funcionário) da granja.'
}

Table fornecedores {
  id uuid [pk]
  user_id integer [not null, unique, ref: > users.id]
  created_at timestamp
  updated_at timestamp

  note: 'Usuário que é fornecedor da granja.'
}

Table clientes {
  id uuid [pk]
  user_id integer [not null, unique, ref: > users.id]
  created_at timestamp
  updated_at timestamp

  note: 'Usuário que é cliente da granja.'
}

Table pessoas.paises {
  id integer [pk, increment, note: 'uso interno, nunca exposto']
  pas_uuid uuid [unique, not null, note: 'identificador publico']
  nome varchar [not null]
  sigla varchar [not null, unique, note: 'codigo ISO 3166-1 alpha-2']
  created_at timestamp
  updated_at timestamp
}

Table pessoas.ufs {
  id integer [pk, increment, note: 'uso interno, nunca exposto']
  est_uuid uuid [unique, not null, note: 'identificador publico']
  pais_id integer [not null, ref: > pessoas.paises.id]
  nome varchar [not null]
  sigla varchar [not null]
  created_at timestamp
  updated_at timestamp
}

Table pessoas.cidades {
  id integer [pk, increment, note: 'uso interno, nunca exposto']
  cid_uuid uuid [unique, not null, note: 'identificador publico']
  uf_id integer [not null, ref: > pessoas.ufs.id]
  nome varchar [not null]
  created_at timestamp
  updated_at timestamp
}

Table pessoas.enderecos {
  id integer [pk, increment, note: 'uso interno, nunca exposto']
  end_uuid uuid [unique, not null, note: 'identificador publico']
  cep varchar [not null]
  logradouro varchar [not null]
  numero varchar [not null]
  complemento varchar [null]
  bairro varchar [not null]
  cidade_id integer [not null, ref: > pessoas.cidades.id]
  created_at timestamp
  updated_at timestamp
}

Table pessoas.colaboradores_enderecos {
  colaborador_id uuid [not null, ref: > colaboradores.id]
  endereco_id integer [not null, ref: > pessoas.enderecos.id]
  indexes { (colaborador_id, endereco_id) [unique] }
}

Table pessoas.fornecedores_enderecos {
  fornecedor_id uuid [not null, ref: > fornecedores.id]
  endereco_id integer [not null, ref: > pessoas.enderecos.id]
  indexes { (fornecedor_id, endereco_id) [unique] }
}

Table pessoas.clientes_enderecos {
  cliente_id uuid [not null, ref: > clientes.id]
  endereco_id integer [not null, ref: > pessoas.enderecos.id]
  indexes { (cliente_id, endereco_id) [unique] }
}

TableGroup producao {
  producao.nucleos
  producao.galpoes
}

Table producao.nucleos {
  id integer [pk, increment, note: 'uso interno, nunca exposto']
  ncl_uuid uuid [unique, not null, note: 'identificador público']
  nome varchar [unique, not null]
  created_at timestamp
  updated_at timestamp

  note: 'Local físico onde os galpões estão localizados.'
}

Table producao.galpoes {
  id integer [pk, increment, note: 'uso interno, nunca exposto']
  glp_uuid uuid [unique, not null, note: 'identificador público']
  nome varchar [not null]
  slug varchar [unique, not null, note: 'slug derivado do nome']
  capacidade integer [not null, note: 'quantidade máxima de aves suportadas a cada alojamento']
  nucleo_id integer [not null, ref: > producao.nucleos.id, note: 'FK interna — nunca exposta']
  status varchar [not null, note: 'StatusGalpao: OCUPADO, DESOCUPADO, VAZIO_SANITARIO']
  created_at timestamp
  updated_at timestamp

  note: 'Estrutura de alojamento de aves para produção de ovos.'
}
